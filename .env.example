# ==============================================================================
# Last Call Leads — Vercel Environment Variables ($0-Budget Launch Ready!)
# Set these ONCE in Vercel -> Project -> Settings -> Environment Variables.
# Zero GitHub Actions needed — Vercel Hobby Cron runs /api/cron/daily & weekly!
# ==============================================================================

# 1) PostgreSQL Database (Neon free tier recommended — $0/mo)
DATABASE_URL="postgresql://user:pass@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2) Security & Auth Secrets (generate 32-byte random hex strings)
ADMIN_KEY="replace-with-strong-admin-password"
CRON_SECRET="replace-with-strong-cron-secret"
UNSUBSCRIBE_SECRET="replace-with-strong-hmac-secret"

# 3) Public Brand & CAN-SPAM Identity
NEXT_PUBLIC_SITE_URL="https://your-project.vercel.app"
NEXT_PUBLIC_BRAND_NAME="Last Call Leads"
NEXT_PUBLIC_CONTACT_EMAIL="supportlastcallleads@gmail.com"
NEXT_PUBLIC_BUSINESS_LEGAL_NAME="Last Call Leads"
NEXT_PUBLIC_BUSINESS_POSTAL_ADDRESS="Your City, State / Mailing Address (required for CAN-SPAM)"
NEXT_PUBLIC_FOUNDER_NAME="Your Name"

# 4) Email Delivery — BEST $0 COMBO WITH YOUR CLOUDFLARE DOMAIN!
# Cloudflare Email Routing handles INCOMING replies (support@yourdomain.com -> Gmail).
# Resend Free (3,000 emails/mo, 100/day, $0 forever) handles OUTGOING customer emails from your domain!
# If Resend ever hits 100/day, SMTP_USER/SMTP_PASS acts as an automatic zero-drop failover!
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxx"
ALERT_FROM_EMAIL="Last Call Leads <alerts@yourdomain.com>"
SMTP_USER="supportlastcallleads@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
OPS_EMAIL="supportlastcallleads@gmail.com"
SUPPORT_INBOX_EMAIL="supportlastcallleads@gmail.com"

# 5) Billing (Dodo Payments — Merchant of Record, USD checkout + Standard Webhooks)
# Webhook URL in Dodo Dashboard: https://yourdomain.com/api/webhooks/dodopayments
DODO_API_KEY="dodo_live_xxxxxxxxxxxxxxxx"
DODO_TEST_MODE="false"
DODO_PRODUCT_ID_SOLO="pdt_solo_129_id"
DODO_PRODUCT_ID_PRO="pdt_pro_249_id"
DODO_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxx"
NEXT_PUBLIC_BILLING_PORTAL_URL="https://app.dodopayments.com"

# 6) Zero-Touch Autonomous Cold Outreach + Day-3 Warm Follow-Ups (Auto-ON once accounts are added!)
# Put 2-4 separate outreach Gmail/Outlook accounts here so your main domain stays 100% spotless:
# Format: "email1@gmail.com:apppass1, email2@gmail.com:apppass2, email3@outlook.com:pass3"
OUTREACH_SMTP_ACCOUNTS=""
# Leave unset to auto-activate whenever OUTREACH_SMTP_ACCOUNTS is set (or set "false" to pause)
# AUTO_OUTREACH_ENABLED="true"
OUTREACH_DAILY_LIMIT="15"
OUTREACH_PER_ACCOUNT_CAP="15"
# OUTREACH_FROM_EMAIL="Your Name <outreach@getlastcallleads.com>"

# 7) Free Phone Monitoring (Telegram Bot via @BotFather — 100% Free!)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# 8) Official LinkedIn Auto-Poster (modern /rest/posts API, instant "Share on LinkedIn" approval)
# Note: LinkedIn user tokens expire every 60 days — Telegram alerts you automatically if it expires.
LINKEDIN_ACCESS_TOKEN=""
LINKEDIN_AUTHOR_URN=""
LINKEDIN_API_VERSION="202604"

# 9) Optional Enhancements
# Free Groq API key enables unique AI-personalized cold outreach openers!
GROQ_API_KEY=""
SOCRATA_APP_TOKEN=""
ENTERPRISE_API_KEYS=""
GEMINI_API_KEY=""
